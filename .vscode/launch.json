{
  "configurations": [
    {
      "type": "firefox",
      "request": "launch",
      "reAttach": true,
      "name": "Launch localhost",
      "url": "http://localhost:39763/${workspaceFolderBasename}/${relativeFile}",
      "webRoot": "${workspaceFolder}",
      "firefoxArgs": ["-width", "400", "-height", "800"]
    },
    {
      "name": "Php",
      "type": "php",
      "request": "launch",
      "port": 9003,
      "xdebugSettings": {
        "max_data": -1,
        "max_children": -1
      }
}
  ]
}